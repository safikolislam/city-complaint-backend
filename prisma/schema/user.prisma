model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String
  role          Role           @default(CITIZEN)
  staffPosition StaffPosition?
  isActive      Boolean        @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  citizenComplaints    Complaint[]              @relation("CitizenComplaints")
  staffComplaints      Complaint[]              @relation("StaffComplaints")
  technicianComplaints Complaint[]              @relation("TechnicianComplaints")
  statusChanges        ComplaintStatusHistory[] @relation("StatusChanges")
  payments             Payment[]
  feedbacks            Feedback[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
  @@index([departmentId, staffPosition])
}
