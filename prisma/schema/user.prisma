model User {
  id                String      @id @default(uuid())
  name              String
  email             String      @unique
  password          String
  role              Role        @default(CITIZEN)
  isDeleted         Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  citizenComplaints Complaint[] @relation("CitizenComplaints")
  staffCompliants   Complaint[] @relation("StaffComplaints")
  payments          Payment[]
  auditLogs         AuditLog[]
}
