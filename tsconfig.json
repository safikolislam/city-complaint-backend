{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2023",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types":["node"],
		"outDir": "dist",
		"rootDir": "./"
	},
	"include": ["src/**/*", "api/**/*", "prisma/seed.ts"],
	"exclude": ["node_modules", "dist"]
}